# docker-compose.yaml
version: '3.7'
services:
  {{ bot_names[0] }}:
    restart: always
    image: golang:1.23
    command: bash -c "chmod +x init.sh && sh init.sh"
    volumes:
      - ./init.sh:/go/init.sh
      - ./downloads:/go/downloads
    environment:
      - AFINA_LOCALE={{ bot_locale }}
      - AI_KEYS={{ bot_api_key }},{{ bot_api_key2 }}
      - AI_NAMES={{ ai_name1 }},{{ ai_name2 }}
      - AI_URLS={{ ai_url1 }},{{ ai_url2 }}
      - AI_BM={{ ai_base_model1 }},{{ ai_base_model2 }}
      - TB_API_KEY={{ tb_api_key }}
      - AFINA_NAMES={{ bot_names[0] }},{{ bot_names[1] }}
      - AFINA_GENDER={{ bot_gender }}
      - OWNER={{ owner }}
      - REDIS_DB={{ redis_db_num }}
      - REDIS_IP={{ ansible_default_ipv4.address }}:6379
      - REDIS_PASS={{ redis_pass }}
volumes:
  afina-storage:
